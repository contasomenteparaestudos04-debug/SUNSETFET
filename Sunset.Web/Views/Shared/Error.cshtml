@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="cartao-centro text-center">
    <h1 class="h3 text-danger">Ops, algo deu errado.</h1>
    <p class="text-muted">Ocorreu um erro ao processar o seu pedido. Tente novamente em alguns instantes.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small">
            <strong>Código do pedido:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Voltar ao início</a>
</div>
